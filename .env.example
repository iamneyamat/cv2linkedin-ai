# ==============================================================================
# CV2LinkedIn AI - Environment Configuration Example
# Copy this file to .env.local for local testing of optional server-side developer keys.
# NEVER commit .env.local or real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPTIONAL SERVER-SIDE PROVIDER API KEYS (DEVELOPER / DEMO MODE ONLY)
# ------------------------------------------------------------------------------
# Server-side API credentials used ONLY when "Developer / Demo Key" mode is selected.
# If unconfigured, the application runs in User API Key (BYOK) mode.
# These credentials remain strictly server-side and NEVER leave the runtime.
# Provider isolation is strictly enforced (No cross-provider fallback).
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# 2. DEFAULT AI PROVIDER
# ------------------------------------------------------------------------------
# Preferred server provider when Developer / Demo mode is used.
# Supported values: "gemini", "openai", "deepseek".
DEFAULT_AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 3. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="CV2LinkedIn AI"
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# Maximum File Upload Size in Megabytes (default: 5MB)
MAX_FILE_SIZE_MB=5

# ------------------------------------------------------------------------------
# 4. LINKEDIN OAUTH 2.0 INTEGRATION
# ------------------------------------------------------------------------------
# LinkedIn Developer App credentials for Sign In with LinkedIn using OpenID Connect.
# Obtained from: https://www.linkedin.com/developers/apps/
# NEVER add real credentials to this example file.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3005/api/linkedin/callback

# 32+ character secret used to sign/encrypt server-side httpOnly session cookies.
# Generated with: openssl rand -base64 32
LINKEDIN_SESSION_SECRET=
